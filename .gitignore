# macOS and editor files
.DS_Store
.cache/
*.swp
*.swo

# ESP-IDF build output; each build directory holds its own sdkconfig
/build/
/build_*/
/build-*/
/managed_components/
/sdkconfig
/sdkconfig.old
*.elf
*.map

# PlatformIO output
**/.pio/

# Local and historical firmware packages
/releases/
/delivery/
/*.zip

# Local credentials or machine-specific overrides
sdkconfig.local
sdkconfig.secrets
*.secrets
.env
.env.*

# Temporary dependency metadata retained only on the development machine
/third_party/.AgIsoStack-plus-plus.git-backup/

