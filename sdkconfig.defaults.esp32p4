# Values taken from the board vendor's lvgl_sw_rotation demo, verified on an
# ESP32-P4 rev v3.2 (JC8012P4A1C_I_W_Y).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# With INFO logging the P4 bootloader is 0x130 bytes too large for the
# partition table at 0x8000; warnings and errors only keep partitions.csv shared.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
