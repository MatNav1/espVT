CONFIG_APP_NO_BLOBS=n
CONFIG_ISOVT_GNSS_SOURCE_UM982=y
CONFIG_ISOVT_UM982_UART_PORT=1
CONFIG_ISOVT_UM982_UART_RX_GPIO=11
CONFIG_ISOVT_UM982_UART_TX_GPIO=12
CONFIG_ISOVT_UM982_UART_BAUD_RATE=460800
CONFIG_ISOVT_ENABLE_NTRIP=y
# The UM982 TX placeholder (GPIO12) is also the MAX98357A WS pin, so audio is off here.
# CONFIG_ISOVT_ENABLE_AUDIO is not set
