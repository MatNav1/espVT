# Settings shared by all espVT targets. Chip settings live in
# sdkconfig.defaults.<chip>, board settings in sdkconfig.defaults.<Board>.<chip>
# and optional features in sdkconfig.defaults.<feature>; make_espVT.sh layers them.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=24576
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_APP_NO_BLOBS=y
CONFIG_ISOVT_ENABLE_AGISOSTACK=y
CONFIG_ISOVT_MANUFACTURER_CODE=0
CONFIG_ISOVT_IDENTITY_NUMBER=1
# The AgIsoStack++ TWAI plugin and can_monitor use the legacy TWAI driver, which
# ESP-IDF 6.x still ships but marks deprecated.
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y
